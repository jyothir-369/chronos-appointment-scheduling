generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SlotStatus {
  open
  booked
  blocked
}

enum BookingStatus {
  booked
  completed
  cancelled
  no_show
}

enum ReminderStatus {
  pending
  sent
  failed
}

enum OffsetType {
  H24
  H1
}

model Provider {
  id                      String   @id @default(uuid())
  name                    String
  timezone                String
  slug                    String   @unique
  cancellationWindowHours Int
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  availabilityRules AvailabilityRule[]
  slots             Slot[]
  bookings          Booking[]
  eventTypes        EventType[]

  @@index([slug])
  @@map("providers")
}

model AvailabilityRule {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      @map("day_of_week")
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([providerId, dayOfWeek])
  @@map("availability_rules")
}

model Slot {
  id           String     @id @default(uuid())
  providerId   String     @map("provider_id")
  provider     Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  slotStartUtc DateTime   @map("slot_start_utc")
  slotEndUtc   DateTime   @map("slot_end_utc")
  status       SlotStatus @default(open)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  bookings Booking[]

  @@unique([providerId, slotStartUtc])
  @@index([providerId, slotStartUtc])
  @@map("slots")
}

model Booking {
  id     String @id @default(uuid())
  slotId String @unique @map("slot_id")
  slot   Slot   @relation(fields: [slotId], references: [id], onDelete: Cascade)

  providerId String?   @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  eventTypeId String? @map("event_type_id")

  status      BookingStatus @default(booked)
  version     Int           @default(0)
  notes       String?
  clientNotes String?       @map("client_notes")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  reminders ReminderJob[]

  @@index([slotId])
  @@index([providerId])
  @@index([clientId])
  @@index([eventTypeId])
  @@map("bookings")
}

model Client {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  company   String?
  phone     String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@index([email])
  @@map("clients")
}

model EventType {
  id              String   @id @default(uuid())
  providerId      String   @map("provider_id")
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title           String
  durationMinutes Int      @map("duration_minutes")
  price           Float?
  location        String?
  slug            String   @unique
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([providerId])
  @@index([slug])
  @@map("event_types")
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  clientId       String   @map("client_id")
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   String   @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([clientId, key])
  @@index([clientId, key])
  @@map("idempotency_keys")
}

model ReminderJob {
  id                String    @id @default(uuid())
  bookingId         String    @map("booking_id")
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offsetMinutes     Int       @map("offset_minutes")
  fireAtUtc         DateTime  @map("fire_at_utc")
  attempts          Int       @default(0)
  lockedUntil       DateTime? @map("locked_until")
  status            String    @default("scheduled") @map("status")
  sentAt            DateTime? @map("sent_at")
  providerMessageId String?   @map("provider_message_id")
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([bookingId, offsetMinutes])
  @@index([status, fireAtUtc])
  @@map("reminder_jobs")
}
