{
  "name": "chronos",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Timezone-Safe Appointment Scheduling Platform — Phase 0 foundations",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "26.0.0",
    "pnpm": ">=12.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test -- --run",
    "test:tz": "TZ=UTC pnpm test:unit && TZ=Asia/Kolkata pnpm test:unit && TZ=America/Los_Angeles pnpm test:unit",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @chronos/api dev",
    "db:up": "docker compose up -d postgres redis",
    "db:verify": "node scripts/verify-infra.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/ui": "^3.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
